      "path": "components/ui/heading-jugend.tsx",
      "content": "/**\n * Jugend variant uses Ambrosia font.\n * License: OFL (SIL Open Font License)\n * https://fontlibrary.org/en/font/ambrosia\n */\nimport * as React from \"react\"\n\nimport { ambrosia } from \"@/lib/fonts/ambrosia\"\nimport { cn } from \"@/lib/utils\"\n\ntype HeadingLevel = 1 | 2 | 3 | 4 | 5 | 6\n\nconst headingTags = {\n  1: \"h1\",\n  2: \"h2\",\n  3: \"h3\",\n  4: \"h4\",\n  5: \"h5\",\n  6: \"h6\",\n} as const satisfies Record<HeadingLevel, `h${HeadingLevel}`>\n\ntype JugendHeadingProps = {\n  level: HeadingLevel\n  ornament?: \"none\" | \"flourish\"\n  season?: \"autumn\" | \"spring\" | \"summer\" | \"winter\"\n  dataVariant?: string\n} & React.ComponentPropsWithoutRef<\"h1\">\n\nconst seasonOrnamentColors = {\n  autumn: { fill: \"#AE8746\", light: \"#D6AC54\", stroke: \"#473418\" },\n  spring: { fill: \"#78AA48\", light: \"#A3CF72\", stroke: \"#2F441B\" },\n  summer: { fill: \"#E0A822\", light: \"#F7C843\", stroke: \"#3F2A04\" },\n  winter: { fill: \"#7BA7CC\", light: \"#A9CDE8\", stroke: \"#1F3A56\" },\n} as const\n\nfunction JugendHeading({\n  level,\n  ornament = \"none\",\n  season = \"autumn\",\n  dataVariant,\n  className,\n  children,\n  ...props\n}: JugendHeadingProps) {\n  const Tag = headingTags[level]\n  const palette = seasonOrnamentColors[season]\n\n  if (ornament === \"flourish\") {\n    return (\n      <Tag\n        data-slot=\"heading\"\n        data-level={level}\n        data-variant={dataVariant ?? \"jugend-flourish\"}\n        className={cn(\n          ambrosia.className,\n          \"inline-flex max-w-full flex-col items-center gap-1.5 tracking-wide\",\n          className\n        )}\n        {...props}\n      >\n        <span>{children}</span>\n        <svg\n          aria-hidden\n          viewBox=\"0 0 220 16\"\n          preserveAspectRatio=\"none\"\n          className=\"h-4 w-full min-w-28\"\n          fill=\"none\"\n        >\n          <path\n            d=\"M4 8 H88 C96 8 101 2.2 110 2.2 C119 2.2 124 8 132 8 H216\"\n            stroke={palette.stroke}\n            strokeWidth=\"1.15\"\n            strokeLinecap=\"round\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n          <path\n            d=\"M22 8 C46 8 68 13.5 92 10.8 C101 9.8 105 13.5 110 13.5 C115 13.5 119 9.8 128 10.8 C152 13.5 174 8 198 8\"\n            stroke={palette.fill}\n            strokeWidth=\"1.5\"\n            strokeLinecap=\"round\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n          <polygon\n            points=\"110,2 116,8 110,14 104,8\"\n            fill={palette.light}\n            stroke={palette.stroke}\n            strokeWidth=\"0.9\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n          <polygon\n            points=\"12,5.5 15,8 12,10.5 9,8\"\n            fill={palette.fill}\n            stroke={palette.stroke}\n            strokeWidth=\"0.7\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n          <polygon\n            points=\"208,5.5 211,8 208,10.5 205,8\"\n            fill={palette.fill}\n            stroke={palette.stroke}\n            strokeWidth=\"0.7\"\n            vectorEffect=\"non-scaling-stroke\"\n          />\n        </svg>\n      </Tag>\n    )\n  }\n\n  return (\n    <Tag\n      data-slot=\"heading\"\n      data-level={level}\n      data-variant={dataVariant ?? \"jugend\"}\n      className={cn(ambrosia.className, \"tracking-wide\", className)}\n      {...props}\n    >\n      {children}\n    </Tag>\n  )\n}\n\nexport { JugendHeading, type HeadingLevel, type JugendHeadingProps }\n",
      "type": "registry:ui"
    },
    {
      "path": "components/ui/heading.tsx",
      "content": "import { cva, type VariantProps } from \"class-variance-authority\"\nimport * as React from \"react\"\n\nimport { cn } from \"@/lib/utils\"\n\nimport { JugendHeading, type HeadingLevel } from \"./heading-jugend\"\n\nconst plaqueBase =\n  \"relative isolate inline-flex max-w-full items-center justify-center overflow-visible border-0 bg-transparent px-8 py-3 text-center sm:px-11 sm:py-3.5 before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:border-solid before:border-y-[16px] before:border-x-[24px] sm:before:border-y-[20px] sm:before:border-x-[30px] before:[border-image-repeat:stretch] before:[border-image-slice:calc(24/72*100%)_calc(36/240*100%)_fill]\"\n\nconst headingVariants = cva(\"\", {\n  variants: {\n    variant: {\n      default: \"\",\n      jugend: \"\",\n      \"jugend-flourish\": \"\",\n      \"autumn-plaque\": `${plaqueBase} text-[#2C1E0F] before:[border-image-source:url('/autumn/heading-frame-1.svg')]`,\n      \"winter-plaque\": `${plaqueBase} text-[#14283D] before:[border-image-source:url('/winter/heading-frame-1.svg')]`,\n      \"spring-plaque\": `${plaqueBase} text-[#1F3114] before:[border-image-source:url('/spring/heading-frame-1.svg')]`,\n      \"summer-plaque\": `${plaqueBase} text-[#2E1E04] before:[border-image-source:url('/summer/heading-frame-1.svg')]`,\n    },\n  },\n  defaultVariants: {\n    variant: \"default\",\n  },\n})\n\nconst headingTags = {\n  1: \"h1\",\n  2: \"h2\",\n  3: \"h3\",\n  4: \"h4\",\n  5: \"h5\",\n  6: \"h6\",\n} as const satisfies Record<HeadingLevel, `h${HeadingLevel}`>\n\ntype HeadingProps = {\n  level: HeadingLevel\n  season?: \"autumn\" | \"spring\" | \"summer\" | \"winter\"\n} & VariantProps<typeof headingVariants> &\n  React.ComponentPropsWithoutRef<\"h1\">\n\nfunction Heading({\n  level,\n  variant = \"default\",\n  season = \"autumn\",\n  className,\n  ...props\n}: HeadingProps) {\n  if (variant === \"jugend\") {\n    return (\n      <JugendHeading\n        level={level}\n        dataVariant=\"jugend\"\n        className={className}\n        {...props}\n      />\n    )\n  }\n\n  if (variant === \"jugend-flourish\") {\n    return (\n      <JugendHeading\n        level={level}\n        ornament=\"flourish\"\n        season={season}\n        dataVariant=\"jugend-flourish\"\n        className={className}\n        {...props}\n      />\n    )\n  }\n\n  if (variant && variant.endsWith(\"-plaque\")) {\n    return (\n      <JugendHeading\n        level={level}\n        dataVariant={variant}\n        className={cn(headingVariants({ variant }), className)}\n        {...props}\n      />\n    )\n  }\n\n  const Tag = headingTags[level]\n\n  return (\n    <Tag\n      data-slot=\"heading\"\n      data-level={level}\n      data-variant={variant}\n      className={cn(headingVariants({ variant }), className)}\n      {...props}\n    />\n  )\n}\n\nexport { Heading, headingVariants, type HeadingLevel, type HeadingProps }\n",
      "type": "registry:ui"
    },
    {
      "path": "lib/fonts/ambrosia.ts",
      "content": "import localFont from \"next/font/local\"\n\nexport const ambrosia = localFont({\n  src: [\n    {\n      path: \"../../assets/fonts/ambrosia/ambrosia-medium.otf\",\n      weight: \"400\",\n      style: \"normal\",\n    },\n  ],\n  variable: \"--font-ambrosia\",\n  display: \"swap\",\n})\n",
      "type": "registry:lib"
    },
